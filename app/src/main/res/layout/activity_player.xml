<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true"
    android:fitsSystemWindows="false">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlc_video_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false"/>

    <View
        android:id="@+id/night_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="1dp"
        android:background="#88000000"
        android:visibility="gone"/>

    <!-- Stable gesture target above LibVLC surfaces and below player controls. -->
    <View
        android:id="@+id/video_touch_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="2dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no"/>

    <LinearLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="4dp"
        android:orientation="vertical"
        android:background="#55000000">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:background="#44000000">

            <ImageButton android:id="@+id/btn_back"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF" android:contentDescription="@string/back"/>

            <TextView android:id="@+id/tv_title"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:paddingHorizontal="6dp"
                android:textColor="#FFFFFF" android:textSize="13sp"
                android:textStyle="bold" android:ellipsize="end" android:maxLines="1"/>

            <TextView android:id="@+id/tv_speed"
                android:layout_width="64dp" android:layout_height="48dp"
                android:gravity="center"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true"
                android:text="1.0x" android:textColor="#FFFFFF" android:textSize="14sp"
                android:contentDescription="@string/player_speed"/>

            <ImageButton android:id="@+id/btn_more"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_more"
                app:tint="#FFFFFF" android:contentDescription="@string/player_more"/>

        </LinearLayout>

        <!-- Center controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton android:id="@+id/btn_prev"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#CCFFFFFF" android:contentDescription="@string/player_previous"/>

            <ImageButton android:id="@+id/btn_rewind"
                android:layout_width="50dp" android:layout_height="50dp"
                android:layout_marginHorizontal="4dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_rew"
                app:tint="#FFFFFF" android:contentDescription="@string/rewind"/>

            <ImageButton android:id="@+id/btn_play_pause"
                android:layout_width="72dp" android:layout_height="72dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/circle_button_bg"
                android:src="@android:drawable/ic_media_pause"
                app:tint="#FFFFFF" android:contentDescription="@string/play_pause"/>

            <ImageButton android:id="@+id/btn_forward"
                android:layout_width="50dp" android:layout_height="50dp"
                android:layout_marginHorizontal="4dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_ff"
                app:tint="#FFFFFF" android:contentDescription="@string/forward"/>

            <ImageButton android:id="@+id/btn_next"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_next"
                app:tint="#CCFFFFFF" android:contentDescription="@string/player_next"/>

        </LinearLayout>

        <!-- Bottom bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp"
            android:background="#44000000">

            <!-- Playlist controls stay one tap away; other tools live in More. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="4dp">

                <ImageButton android:id="@+id/btn_shuffle"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="#AAFFFFFF" android:alpha="0.5"
                    android:contentDescription="@string/player_shuffle"/>

                <ImageButton android:id="@+id/btn_repeat"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_rotate"
                    app:tint="#AAFFFFFF" android:alpha="0.4"
                    android:contentDescription="@string/player_repeat"/>

                <View android:layout_width="0dp" android:layout_height="0dp"
                    android:layout_weight="1"/>

                <ImageButton android:id="@+id/btn_queue"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="#AAFFFFFF" android:contentDescription="@string/player_queue"/>

            </LinearLayout>

            <SeekBar android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="#5865F2"
                android:thumbTint="#5865F2"/>

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/tv_current"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="00:00" android:textColor="#B5BAC1" android:textSize="12sp"/>

                <View android:layout_width="0dp" android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView android:id="@+id/tv_total"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="00:00" android:textColor="#B5BAC1" android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Lock overlay - chi hien thi btn_unlock -->
    <FrameLayout
        android:id="@+id/lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <ImageButton android:id="@+id/btn_unlock"
                android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/circle_button_bg"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="#FFFFFF" android:contentDescription="@string/player_unlock"/>

            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mở khóa" android:textColor="#AAFFFFFF"
                android:textSize="10sp" android:layout_marginTop="4dp"/>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
